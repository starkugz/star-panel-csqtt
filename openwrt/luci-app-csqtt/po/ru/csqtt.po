msgid "Connection"
msgstr "Подключение"

msgid "Connection secret. The stored password is never read back; an empty field keeps the existing value."
msgstr "Секрет подключения. Сохранённый пароль не считывается обратно; пустое поле сохраняет существующее значение."

msgid "DNS for the tunnel connection. CSQTT does not change the system DNS of OpenWrt or dnsmasq."
msgstr "DNS для туннельного соединения. CSQTT не изменяет системный DNS OpenWrt или dnsmasq."

msgid "Data transfer"
msgstr "Передача данных"

msgid "Debug creates more log entries and may increase load."
msgstr "Debug создаёт больше записей журнала и может увеличить нагрузку."

msgid "Device ID is bound to the existing access/password. Do not change or regenerate without unbinding it on the server."
msgstr "Device ID привязан к существующему доступу/паролю. Не изменяйте и не создавайте заново без отвязки на сервере."

msgid "Disabled profiles do not participate in automatic selection."
msgstr "Отключённые профили не участвуют в автоматическом выборе."

msgid "Display name of the profile in LuCI."
msgstr "Отображаемое имя профиля в LuCI."

msgid "Do not set the maximum without measuring throughput, CPU, RAM, temperature and ping."
msgstr "Не устанавливайте максимум без измерения скорости, CPU, RAM, температуры и ping."

msgid "Empty = use the global setting (%s · %s)."
msgstr "Пусто = использовать глобальную настройку (%s · %s)."

msgid "Empty = use the global setting (%s)."
msgstr "Пусто = использовать глобальную настройку (%s)."

msgid "Failover overrides"
msgstr "Переопределения failover"

msgid "Failure threshold (override)"
msgstr "Порог отказов (переопределение)"

msgid "Health check mode"
msgstr "Режим проверки состояния"

msgid "How CAPTCHA is solved: auto, wv (WebView) or rjs (Rust JS)."
msgstr "Способ решения CAPTCHA: auto, wv (WebView) или rjs (Rust JS)."

msgid "How VK hashes are obtained: manual (from the VK field) or auto_js. auto_js also needs VK auth mode auto_js and a VK JS token."
msgstr "Способ получения хешей VK: manual (из поля VK) или auto_js. Для auto_js также нужны режим авторизации VK auto_js и VK JS token."

msgid "How long a higher-priority profile must stay stable before automatic failback."
msgstr "Сколько времени более приоритетный профиль должен работать стабильно перед автоматическим failback."

msgid "How many consecutive failed checks are required before a profile is considered unhealthy."
msgstr "Сколько последовательных неудачных проверок требуется, прежде чем профиль считается неисправным."

msgid "How many successful checks are required to confirm the profile works stably again."
msgstr "Сколько успешных проверок требуется для подтверждения стабильной работы профиля."

msgid "How often CSQTT checks the connection state."
msgstr "Как часто CSQTT проверяет состояние соединения."

msgid "Identification / compatibility"
msgstr "Идентификация / совместимость"

msgid "If empty, internal connection-state signals are used. The target is only an extra check."
msgstr "Если поле пустое, используются внутренние признаки состояния соединения. Цель является только дополнительной проверкой."

msgid "Internal UCI section name (letters, digits, underscore)."
msgstr "Внутреннее имя секции UCI (буквы, цифры, подчёркивание)."

msgid "Logging"
msgstr "Журналирование"

msgid "Logging · Advanced"
msgstr "Журналирование · Расширенные"

msgid "Lower number means higher priority (10 is preferred over 20)."
msgstr "Меньшее число означает более высокий приоритет (10 выше, чем 20)."

msgid "Maximum IP packet size of the csqtt0 interface. A larger MTU is not always faster."
msgstr "Максимальный размер IP-пакета интерфейса csqtt0. Большее MTU не всегда означает большую скорость."

msgid "Maximum log size"
msgstr "Максимальный размер журнала"

msgid "Network"
msgstr "Сеть"

msgid "Network · Advanced"
msgstr "Сеть · Расширенные"

msgid "Network · Performance"
msgstr "Сеть · Производительность"

msgid "Number of parallel CSQTT worker channels. Multiple of 9, 9..126 (server limit)."
msgstr "Количество параллельных рабочих каналов CSQTT. Кратно 9, диапазон 9–126 (ограничение сервера)."

msgid "Obfuscation (OBFS)"
msgstr "Обфускация (OBFS)"

msgid "Obfuscation profile used by the connection (audio or video)."
msgstr "Профиль обфускации соединения (audio или video)."

msgid "On problems with the current profile CSQTT can switch to the next available profile. Works in priority selection mode."
msgstr "При проблемах с текущим профилем CSQTT может переключиться на следующий доступный профиль. Работает в режиме выбора по приоритету."

msgid "Path to the local CSQTT log file."
msgstr "Путь к локальному файлу журнала CSQTT."

msgid "Pause between repeated connection attempts."
msgstr "Пауза между повторными попытками подключения."

msgid "Performance"
msgstr "Производительность"

msgid "Performance · CPU/RAM"
msgstr "Производительность · CPU/RAM"

msgid "Priority: CSQTT automatically picks the best available enabled profile. Manual: only the selected active profile is used."
msgstr "По приоритету: CSQTT автоматически выбирает лучший доступный включённый профиль. Вручную: используется только выбранный активный профиль."

msgid "Profile enabled"
msgstr "Профиль включён"

msgid "Profile selection mode"
msgstr "Режим выбора профиля"

msgid "Profile used in manual mode."
msgstr "Профиль, используемый в ручном режиме."

msgid "Reliability"
msgstr "Надёжность"

msgid "Secret used by auto_js mode. Accepts the access token itself or the full OAuth redirect URL containing access_token. Never shown; an empty field keeps the stored value."
msgstr "Секрет для режима auto_js. Принимает сам access-токен или полный redirect-URL с access_token. Значение никогда не отображается; пустое поле сохраняет существующее значение."

msgid "Security"
msgstr "Безопасность"

msgid "Server / Peer"
msgstr "Сервер / Peer"

msgid "Service"
msgstr "Сервис"

msgid "TLS fingerprint used by the client: chrome or firefox."
msgstr "TLS fingerprint клиента: chrome или firefox."

msgid "Transport"
msgstr "Транспорт"

msgid "Transport + data"
msgstr "Транспорт + данные"

msgid "Transport affects compatibility, latency and connection behaviour. Use a mode supported by the server (tcp is stored as tcp_tls)."
msgstr "Транспорт влияет на совместимость, задержку и поведение соединения. Используйте режим, поддерживаемый сервером (tcp хранится как tcp_tls)."

msgid "Transport: checks connection, workers and control-plane state. Data: evaluates actual traffic signs. Transport + data: both checks (recommended production mode)."
msgstr "Транспорт: проверяет соединение, воркеры и control-plane. Данные: оценивает фактическую передачу данных. Транспорт + данные: выполняет обе проверки."

msgid "User note. Does not affect the connection."
msgstr "Пользовательская заметка. Не влияет на соединение."

msgid "VK auth path: vkcalls (default) or auto_js."
msgstr "Путь авторизации VK: vkcalls (по умолчанию) или auto_js."

msgid "VK client IDs (advanced; leave empty to use defaults)."
msgstr "ID клиентов VK (расширенная настройка; оставьте пустым для значений по умолчанию)."

msgid "When the size is reached the existing log rotation is used."
msgstr "При достижении указанного размера используется существующая ротация журнала."

msgid "required for an enabled profile"
msgstr "требуется для включённого профиля"

msgid "— global —"
msgstr "— глобально —"

msgid "— unchanged —"
msgstr "— не изменять —"

