msgid "csqtt://connect?v=2&host=…&peer=…&password=… (or legacy csqtt://pass@host:port)"
msgstr "csqtt://connect?v=2&host=…&peer=…&password=… (или старый формат csqtt://pass@host:port)"

msgid "VK token not recognized. Paste the token itself or the full OAuth redirect URL containing access_token."
msgstr "VK-токен не распознан. Вставьте сам токен или полный redirect-URL с access_token."

