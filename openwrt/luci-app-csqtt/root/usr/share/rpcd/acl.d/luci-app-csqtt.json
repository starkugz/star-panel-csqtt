{
	"luci-app-csqtt": {
		"description": "CSQTT tunnel: read status/logs, manage service/profiles/captcha",
		"read": {
			"ubus": {
				"csqtt": [
					"status",
					"logs",
					"test_conf",
					"profiles",
					"hashes_validate",
					"captcha_list",
					"captcha_helper_info"
				]
			},
			"uci": {
				"csqtt": true
			}
		},
		"write": {
			"ubus": {
				"csqtt": [
					"logs_clear",
					"service",
					"test_conf",
					"profile_action",
					"profile_import",
					"profile_export",
					"captcha_cancel",
					"captcha_helper_url"
				]
			},
			"uci": {
				"csqtt": true
			}
		}
	}
}
