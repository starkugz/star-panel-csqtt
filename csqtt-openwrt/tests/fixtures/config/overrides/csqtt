config csqtt 'main'
	option enabled '0'
	option selection_mode 'priority'
	option failover '1'
	option failback '1'
	option health_interval '10'
	option fail_threshold '3'
	option success_threshold '2'
	option cooldown '90'
	option reconnect_delay '5'
	option failback_stable_time '120'
	option health_mode 'transport'
	option captcha_policy 'wait'
	option tun_mtu '1420'
	option log_level 'debug'
	option log_file '/var/log/csqtt.log'
	option log_size_kb '256'

config csqtt 'routing'
	option mode 'none'

config server 'first'
	option name 'First'
	option enabled '1'
	option priority '10'
	option peer '198.51.100.10:46000'
	option password 'first-password'
	option vk 'abcdefghijklmnop1'
	option workers '27'
	option fail_threshold ''
	option success_threshold ''
	option cooldown ''
	option captcha_policy ''

config server 'second'
	option name 'Second'
	option enabled '1'
	option priority '20'
	option peer '198.51.100.20:46000'
	option password 'second-password'
	option vk 'abcdefghijklmnop2'
	option workers '36'
	option fail_threshold '5'
	option success_threshold '1'
	option cooldown '15'
	option captcha_policy 'failover'
